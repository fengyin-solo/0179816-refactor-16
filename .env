# ============================================================
# 共享运行参数：本地开发（npm run dev）与容器（docker compose）
# 都从这份文件取值，改端口/版本只需改这里。
# ============================================================

# 应用监听端口（本地 dev/preview 与容器内 nginx 共用）
PORT=8081

# 构建镜像使用的基镜像版本（docker compose build 时作为 build-arg 传入）
NODE_VERSION=20-alpine
NGINX_VERSION=1.27-alpine
